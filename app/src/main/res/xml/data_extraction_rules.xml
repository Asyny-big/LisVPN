<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ data-extraction policy. Mirrors backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="encrypted/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="encrypted/" />
    </device-transfer>
</data-extraction-rules>
